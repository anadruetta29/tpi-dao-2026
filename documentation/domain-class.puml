@startuml
title Sistema de Préstamos Interbibliotecarios - Modelo de Auditoría y Logística

skinparam classAttributeIconSize 0
hide empty methods
skinparam noteBackgroundColor #LightYellow
skinparam noteBorderColor #DarkGoldenRod

' =========================
' ENUMS
' =========================

enum EstadoSocio {
    HABILITADO
    INHABILITADO
}

enum EstadoSede {
    ACTIVA
    BAJA
}

enum EstadoEjemplar {
    DISPONIBLE
    PRESTADO
    RESERVADO
    EN_TRANSITO
    EN_REVISION
    DANADO
    EXTRAVIADO
    DESTRUIDO
}

enum TipoPrestamo {
    LOCAL
    INTERBIBLIOTECARIO
}

enum EstadoSolicitud {
    PENDIENTE
    APROBADA
    RECHAZADA
    CANCELADA
}

enum EstadoPrestamo {
    ACTIVO
    DEVUELTO
    VENCIDO
}

enum EstadoReserva {
    ACTIVA
    ATENDIDA
    CANCELADA
    VENCIDA
}

enum EstadoEnvio {
    PENDIENTE
    EMPACADO
    DESPACHADO
    EN_TRANSITO
    RECIBIDO
    CON_INCIDENCIA
}

enum ModalidadPrestamoLocal {
    DOMICILIO
    SALA_LECTURA
}

enum MotivoMulta {
    ENTREGA_TARDIA
    EXTRAVIO
    DESTRUCCION
}

enum EstadoMulta {
    PENDIENTE
    PAGADA
    ANULADA
}

' =========================
' CLASES
' =========================

class Socio {
    nombre
    apellido
    documento
    email
    telefono
    estado: EstadoSocio
}

class Sede {
    nombre
    telefono
    email
    horarioAtencion
    estado: EstadoSede
}

class Libro {
    titulo 
    añoPublicacion
    editorial
    edicion
}

class Autor {
    nombre
    apellido
}

class Ejemplar {
    codigo 
    estado: EstadoEjemplar
}

class Reserva {
    fecha 
    estado: EstadoReserva
}

class SolicitudPrestamo {
    numero
    tipo: TipoPrestamo
    estado: EstadoSolicitud
}

class Prestamo {
    fechaInicio
    fechaVencimiento
    fechaDevolucion
    estado: EstadoPrestamo
    modalidad: ModalidadPrestamoLocal
}

class Devolucion {
    fecha
    observaciones
    estadoDevuelto: EstadoEjemplar
}

' --- MULTAS --- '
class Multa {
    fechaEmision
    motivo: MotivoMulta
    monto
    estado: EstadoMulta
    fechaPago
}

' --- CLASES DE LOGÍSTICA REESTRUCTURADAS ---

class Remito {
    numero 
    fechaEmision
    fechaDespacho
    fechaRecepcion
}

class HistorialEstadoRemito {
    fechaInicio
    fechaFin
    estado: EstadoEnvio
}

' =========================
' RELACIONES
' =========================

' 1. Flujo de usuario
Socio --> "0..*" Reserva
Socio --> "0..*" SolicitudPrestamo
Reserva --> "1" Libro
Reserva ..> SolicitudPrestamo : genera >

' 2. Flujo de solicitud y logística
SolicitudPrestamo --> "1" Sede : sedeOrigen
SolicitudPrestamo --> "1" Sede : sedeDestino
SolicitudPrestamo --> "0..1" Prestamo : se_convierte_en >
SolicitudPrestamo --> "0..1" Remito : tiene >

' 3. Flujo de préstamo y ejemplares
Prestamo --> "1" Ejemplar
Sede --> "1" Ejemplar
Libro --> "1..*" Autor
Libro --> "1..*" Ejemplar

' 4. Flujo de devolución
Prestamo --> "0..1" Devolucion

' 5. Logística y Trazabilidad (Relaciones Corregidas)
Remito --> "1..*" HistorialEstadoRemito : tiene_historial >

' 6. Dependencias de tipo (Enums)
Socio ..> EstadoSocio
Sede ..> EstadoSede
Ejemplar ..> EstadoEjemplar
Reserva ..> EstadoReserva
SolicitudPrestamo ..> EstadoSolicitud
SolicitudPrestamo ..> TipoPrestamo
Prestamo ..> EstadoPrestamo
HistorialEstadoRemito ..> EstadoEnvio
Devolucion ..> EstadoEjemplar

' 7. Multas 
Prestamo -- "0..1" Multa : genera
Prestamo ..> ModalidadPrestamoLocal
Multa ..> MotivoMulta
Multa ..> EstadoMulta

' =========================
' NOTAS
' =========================

note top of Remito
  **Remito:** Documento legal independiente
  que respalda el traslado de la mercadería.
  No tiene estado directo, se determina consultando el último registro del historial.
end note

@enduml
